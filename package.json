{
  "name": "pi-media-router",
  "version": "0.2.0",
  "description": "Route local media through multimodal APIs before a text-only Pi model handles the request.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreenNa717/pi-media.git"
  },
  "homepage": "https://github.com/GreenNa717/pi-media#readme",
  "bugs": {
    "url": "https://github.com/GreenNa717/pi-media/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "multimodal",
    "media-router"
  ],
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "pack:dry": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
